{
  "entities": {
    "SuratMasuk": {
      "title": "SuratMasuk",
      "description": "Dokumen pencatatan surat masuk di SDN 1 Pekutatan",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "noAgenda": { "type": "string", "maxLength": 50 },
        "noSurat": { "type": "string", "maxLength": 100 },
        "tglSurat": { "type": "string", "maxLength": 30 },
        "tglTerima": { "type": "string", "maxLength": 30 },
        "pengirim": { "type": "string", "maxLength": 200 },
        "perihal": { "type": "string", "maxLength": 500 },
        "sifat": { "type": "string", "enum": ["Biasa", "Penting", "Sangat Penting", "Rahasia"] },
        "status": { "type": "string", "enum": ["Menunggu Tindak Lanjut", "Sedang Diproses", "Selesai"] },
        "tglTindakLanjut": { "type": "string", "maxLength": 30 },
        "disposisi": { "type": "string", "maxLength": 1000 },
        "diteruskanKepada": { "type": "string", "maxLength": 200 },
        "keterangan": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["noSurat", "pengirim", "perihal", "tglTerima"]
    },
    "SuratKeluar": {
      "title": "SuratKeluar",
      "description": "Dokumen surat keluar SDN 1 Pekutatan",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "jenisSurat": { "type": "string", "enum": ["surat_ijin_guru", "surat_keterangan", "surat_undangan", "surat_keputusan", "surat_tugas", "surat_pengantar", "surat_rekomendasi", "surat_permohonan", "surat_eksternal", "lainnya"] },
        "noSurat": { "type": "string", "maxLength": 150 },
        "kodeKlasifikasi": { "type": "string", "maxLength": 50 },
        "namaKlasifikasi": { "type": "string", "maxLength": 200 },
        "tglSurat": { "type": "string", "maxLength": 30 },
        "tujuan": { "type": "string", "maxLength": 300 },
        "perihal": { "type": "string", "maxLength": 500 },
        "isiSurat": { "type": "string", "maxLength": 5000 },
        "dataKhusus": { "type": "object" },
        "status": { "type": "string", "enum": ["Konsep", "Disetujui", "Terkirim", "Diarsipkan"] },
        "penandatangan": { "type": "string", "maxLength": 200 },
        "nipPenandatangan": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["noSurat", "jenisSurat", "tglSurat", "perihal"]
    },
    "ArsipSurat": {
      "title": "ArsipSurat",
      "description": "Arsip fisik dan digital surat keluar",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "noSurat": { "type": "string", "maxLength": 150 },
        "kodeKlasifikasi": { "type": "string", "maxLength": 50 },
        "perihal": { "type": "string", "maxLength": 500 },
        "tujuan": { "type": "string", "maxLength": 300 },
        "tglArsip": { "type": "string", "maxLength": 30 },
        "lokasiFisik": { "type": "string", "maxLength": 200 },
        "kategori": { "type": "string", "maxLength": 100 },
        "keterangan": { "type": "string", "maxLength": 500 }
      },
      "required": ["noSurat", "perihal", "tglArsip"]
    },
    "Guru": {
      "title": "Guru",
      "description": "Data Pendidik dan Tenaga Kependidikan SDN 1 Pekutatan",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "nip": { "type": "string", "maxLength": 30 },
        "nuptk": { "type": "string", "maxLength": 50 },
        "nama": { "type": "string", "maxLength": 200 },
        "jabatan": { "type": "string", "maxLength": 100 },
        "pangkatGol": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "enum": ["PNS", "PPPK", "Honorer", "GTT"] },
        "jenisPtk": { "type": "string", "enum": ["kepala_sekolah", "guru", "tu"] },
        "noHp": { "type": "string", "maxLength": 30 },
        "email": { "type": "string", "maxLength": 100 }
      },
      "required": ["nama", "jabatan"]
    },
    "Siswa": {
      "title": "Siswa",
      "description": "Data Peserta Didik SDN 1 Pekutatan",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "nisn": { "type": "string", "maxLength": 30 },
        "nis": { "type": "string", "maxLength": 30 },
        "nama": { "type": "string", "maxLength": 200 },
        "kelas": { "type": "string", "maxLength": 10 },
        "jenisKelamin": { "type": "string", "enum": ["L", "P"] },
        "tempatLahir": { "type": "string", "maxLength": 100 },
        "tglLahir": { "type": "string", "maxLength": 30 },
        "namaOrtu": { "type": "string", "maxLength": 200 },
        "alamat": { "type": "string", "maxLength": 300 }
      },
      "required": ["nama", "kelas", "jenisKelamin"]
    },
    "PengaturanSekolah": {
      "title": "PengaturanSekolah",
      "description": "Identitas sekolah dan template kop SDN 1 Pekutatan",
      "type": "object",
      "properties": {
        "namaSekolah": { "type": "string", "maxLength": 200 },
        "npsn": { "type": "string", "maxLength": 30 },
        "nss": { "type": "string", "maxLength": 30 },
        "instansiBaris1": { "type": "string", "maxLength": 200 },
        "instansiBaris2": { "type": "string", "maxLength": 200 },
        "instansiBaris3": { "type": "string", "maxLength": 200 },
        "alamat": { "type": "string", "maxLength": 300 },
        "desa": { "type": "string", "maxLength": 100 },
        "kecamatan": { "type": "string", "maxLength": 100 },
        "kabupaten": { "type": "string", "maxLength": 100 },
        "provinsi": { "type": "string", "maxLength": 100 },
        "kodePos": { "type": "string", "maxLength": 20 },
        "telepon": { "type": "string", "maxLength": 50 },
        "email": { "type": "string", "maxLength": 100 },
        "website": { "type": "string", "maxLength": 100 },
        "kepalaSekolah": { "type": "string", "maxLength": 200 },
        "nipKepalaSekolah": { "type": "string", "maxLength": 50 },
        "pangkatKepalaSekolah": { "type": "string", "maxLength": 100 },
        "kodeSuratSekolah": { "type": "string", "maxLength": 50 },
        "kopImageUrl": { "type": "string", "maxLength": 900000 },
        "capSekolahUrl": { "type": "string", "maxLength": 900000 },
        "ttdKepalaSekolahUrl": { "type": "string", "maxLength": 900000 }
      },
      "required": ["namaSekolah", "kepalaSekolah"]
    },
    "Ekstrakurikuler": {
      "title": "Ekstrakurikuler",
      "description": "Data kegiatan ekstrakurikuler dan daftar peserta murid SDN 1 Pekutatan",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "nama": { "type": "string", "maxLength": 150 },
        "pembina": { "type": "string", "maxLength": 150 },
        "hari": { "type": "string", "maxLength": 60 },
        "waktu": { "type": "string", "maxLength": 80 },
        "tempat": { "type": "string", "maxLength": 150 },
        "keterangan": { "type": "string", "maxLength": 500 },
        "pesertaIds": { "type": "array" },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["nama", "pembina", "hari", "pesertaIds"]
    },
    "PresensiSiswaDoc": {
      "title": "PresensiSiswaDoc",
      "description": "Catatan presensi harian murid per kelas",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "tanggal": { "type": "string", "maxLength": 30 },
        "kelas": { "type": "string", "maxLength": 30 },
        "records": { "type": "object" },
        "catatan": { "type": "string", "maxLength": 500 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["tanggal", "kelas", "records", "updatedAt"]
    },
    "PresensiEkstraDoc": {
      "title": "PresensiEkstraDoc",
      "description": "Catatan presensi pertemuan kegiatan ekstrakurikuler murid",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "ekstraId": { "type": "string", "maxLength": 128 },
        "tanggal": { "type": "string", "maxLength": 30 },
        "materi": { "type": "string", "maxLength": 500 },
        "records": { "type": "object" },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["ekstraId", "tanggal", "records", "updatedAt"]
    },
    "LokerPtkItem": {
      "title": "LokerPtkItem",
      "description": "Loker pribadi PTK untuk administrasi kepegawaian, catatan penting, dan administrasi pembelajaran",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "ptkId": { "type": "string", "maxLength": 128 },
        "ptkNama": { "type": "string", "maxLength": 200 },
        "kategori": { "type": "string", "maxLength": 100 },
        "visibilitas": { "type": "string", "enum": ["privat", "terbuka"] },
        "judul": { "type": "string", "maxLength": 200 },
        "tanggal": { "type": "string", "maxLength": 30 },
        "isiCatatan": { "type": "string", "maxLength": 10000 },
        "fileNama": { "type": "string", "maxLength": 255 },
        "fileTipe": { "type": "string", "maxLength": 150 },
        "fileUkuran": { "type": "string", "maxLength": 50 },
        "fileUrl": { "type": "string", "maxLength": 950000 },
        "linkEksternal": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["ptkId", "ptkNama", "kategori", "judul", "tanggal", "createdAt", "updatedAt"]
    },
    "LokerPtkAccess": {
      "title": "LokerPtkAccess",
      "description": "Pengaturan akses, proteksi password, dan visibilitas bawaan untuk Loker Room PTK",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "ptkId": { "type": "string", "maxLength": 128 },
        "ptkNama": { "type": "string", "maxLength": 200 },
        "isProtected": { "type": "boolean" },
        "passwordHash": { "type": "string", "maxLength": 200 },
        "passwordHint": { "type": "string", "maxLength": 200 },
        "defaultVisibilitas": { "type": "string", "enum": ["privat", "terbuka"] },
        "cardColor": { "type": "string", "maxLength": 30 },
        "customFolders": { "type": "array", "description": "Daftar nama folder tambahan di dalam loker PTK" },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["ptkId", "ptkNama", "isProtected", "passwordHash", "updatedAt"]
    }
  },
  "firestore": {
    "/suratMasuk/{suratId}": {
      "schema": "SuratMasuk",
      "description": "Koleksi surat masuk"
    },
    "/suratKeluar/{suratId}": {
      "schema": "SuratKeluar",
      "description": "Koleksi surat keluar resmi"
    },
    "/arsipSurat/{arsipId}": {
      "schema": "ArsipSurat",
      "description": "Koleksi arsip surat keluar"
    },
    "/guru/{guruId}": {
      "schema": "Guru",
      "description": "Koleksi data guru dan staf"
    },
    "/siswa/{siswaId}": {
      "schema": "Siswa",
      "description": "Koleksi data siswa"
    },
    "/settings/identitas": {
      "schema": "PengaturanSekolah",
      "description": "Data identitas sekolah dan kop"
    },
    "/ekstrakurikuler/{ekstraId}": {
      "schema": "Ekstrakurikuler",
      "description": "Koleksi daftar ekstrakurikuler sekolah dan anggota siswa"
    },
    "/presensiSiswa/{presensiId}": {
      "schema": "PresensiSiswaDoc",
      "description": "Koleksi presensi harian siswa per kelas"
    },
    "/presensiEkstra/{presensiId}": {
      "schema": "PresensiEkstraDoc",
      "description": "Koleksi presensi pertemuan ekstrakurikuler"
    },
    "/lokerPtk/{itemId}": {
      "schema": "LokerPtkItem",
      "description": "Koleksi dokumen dan catatan pribadi pada Loker Room PTK"
    },
    "/lokerPtkAccess/{ptkId}": {
      "schema": "LokerPtkAccess",
      "description": "Pengaturan akses & password Loker Room per PTK"
    }
  }
}
